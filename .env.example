# ── Resend (Email) ──
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# The email address that receives enquiries (your business email)
CONTACT_EMAIL=info@deckpromarine.com.au

# ── Cloudinary (Image Uploads) ──
# Get these from https://console.cloudinary.com/settings
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_api_secret

# ── Cloudinary Upload Preset (unsigned, for browser uploads) ──
# Create at: Cloudinary Dashboard → Settings → Upload → Upload Presets → Add
# Set "Signing Mode" to "Unsigned"
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=deckpro_uploads
